// Structural test of the JDBC annotated-mapping VirtualModels: load the mapping and reflect VirtualModels and check their structure.
// (Query/connection use-cases are covered by the DB-connected scripts.)

service ResourceCenterService status;
resources;
context;

// Load the annotated mapping VirtualModel (@Table / @Property)
mappingVM = load -r ["http://openflexo.org/jdbc-test/FML/JDBCMapping.fml"];
assert mappingVM != null;
log "Mapping VM pretty-print:";
log mappingVM.fMLPrettyPrint;
assert mappingVM.flexoConcepts.size() == 2;

// Load the reflect VirtualModel (declares a HbnModelSlot typed with the mapping VirtualModel)
reflectVM = load -r ["http://openflexo.org/jdbc-test/FML/JDBCReflect.fml"];
assert reflectVM != null;
log "Reflect VM pretty-print:";
log reflectVM.fMLPrettyPrint;
