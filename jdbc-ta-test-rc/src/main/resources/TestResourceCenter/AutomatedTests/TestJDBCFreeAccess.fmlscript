// Demonstrates the low-level JDBCModelSlot (FreeModelSlot): structural access to a database (tables, columns, rows)
// without any mapping VirtualModel. The database and JDBCConnection resource are provisioned by the AutomatedTests runner.

service ResourceCenterService status;
context;

freeVM = load -r ["http://openflexo.org/jdbc-test/FML/JDBCFreeAccess.fml"];
assert freeVM != null;

connection = load -r ["http://openflexo.org/jdbc-test/TestDB.jdbc"];
assert connection != null;

service ResourceCenterService add_temp_rc;
myVMI = new JDBCFreeAccess(connection.resource) with (name="testFreeAccess");
assert myVMI != null;

// List all tables of the schema (structural access, no mapping VirtualModel)
tables = myVMI.getAllTables();
log "tables=" + tables;
assert tables.size() == 2;

// Columns of the CLIENT table: ID, NAME, SALESMAN
clientColumns = myVMI.getClientColumns();
log "clientColumns=" + clientColumns;
assert clientColumns.size() == 3;

// Rows of the CLIENT table (raw select, no FML-concept mapping)
clientRows = myVMI.getClientRows();
log "clientRows=" + clientRows;
assert clientRows.size() == 3;

// Rows of the SALESMAN table
salesmanRows = myVMI.getSalesmanRows();
log "salesmanRows=" + salesmanRows;
assert salesmanRows.size() == 2;
