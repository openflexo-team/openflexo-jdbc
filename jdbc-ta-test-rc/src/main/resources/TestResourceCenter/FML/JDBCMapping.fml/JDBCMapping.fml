use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import java.lang.String;

/*
 * A mapping VirtualModel: its concepts are mapped onto a relational schema through @Table / @Property FML annotations.
 * CLIENT(ID, NAME, SALESMAN) references SALESMAN(ID, LASTNAME).
 */
@URI("http://openflexo.org/jdbc-test/FML/JDBCMapping.fml")
public model JDBCMapping {

   @Table("SALESMAN")
   public concept Salesman {
      @Property(column="ID", id="true")
      int id;
      @Property(column="LASTNAME")
      String lastname;
      @Property(mappedBy="SALESMAN")
      Client[0,*] clients with ConceptInstance();
   }

   @Table("CLIENT")
   public concept Client {
      @Property(column="ID", id="true")
      int id;
      @Property(column="NAME")
      String name;
      @Property(column="SALESMAN", fk="ID")
      Salesman salesman with ConceptInstance();
   }
}
